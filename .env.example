# Copy to .env and fill in the keys for the agent/model you want to run.
# Harbor and the helper scripts read these from the environment.

# Model provider (OpenRouter is used by the bundled Terminus configs)
OPENROUTER_API_KEY=

# Optional: run on Modal sandboxes instead of local Docker
#   uv tool install "harbor[modal]"
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional: other Harbor-supported providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
